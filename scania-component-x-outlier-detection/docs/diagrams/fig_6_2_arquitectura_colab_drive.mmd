flowchart LR
    subgraph GIT[Repositorio Git]
        CODE[src, scripts, main.py]
        CFG[config]
        TEST[tests]
        DOCS[docs y notebooks]
    end

    subgraph COLAB[Google Colab]
        RUNNER[run_colab_safe.py]
        SPARK[PySpark]
        TORCH[PyTorch GPU]
    end

    subgraph DRIVE[Google Drive - TFM_SCANIA]
        RAW[data/raw]
        CACHE[data/processed/windows]
        RUNS[experiments/runs/run-name]
        ART[modelos, métricas, predicciones, tablas, figuras y logs]
    end

    CODE --> RUNNER
    CFG --> RUNNER
    RUNNER --> SPARK
    RUNNER --> TORCH
    RAW --> SPARK
    SPARK --> CACHE
    CACHE --> TORCH
    TORCH --> RUNS
    RUNS --> ART
